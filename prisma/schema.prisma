// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  male
  female
  other
}

model User {
  id                      String                   @id @default(uuid())
  name                    String?
  gender                  Gender?
  heightCm                Int?
  birthDate               DateTime?                @db.Date
  updatedAt               DateTime                 @updatedAt
  prompts                 Prompt[]
  chats                   Chat[]
  messages                Message[]
  feedbacks               Feedback[]
  googleHealthConnections GoogleHealthConnection[]
  bodyLogs                BodyLog[]
  activityLogs            ActivityLog[]
}

model Prompt {
  id        String    @id @default(uuid())
  title     String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  messages  Message[]
}

model Chat {
  id        String    @id @default(uuid())
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  messages  Message[]
}

model Message {
  id        String     @id @default(uuid())
  content   String
  startDate DateTime   @db.Date
  endDate   DateTime   @db.Date
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  prompt    Prompt?    @relation(fields: [promptId], references: [id], onDelete: SetNull)
  promptId  String?
  chat      Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String
  feedbacks Feedback[]
}

model Feedback {
  id             String   @id @default(uuid())
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  promptSnapshot String
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId      String
}

model GoogleHealthConnection {
  id           String        @id @default(uuid())
  userId       String        @unique
  googleUserId String?
  scope        String
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyLogs     BodyLog[]
  activityLogs ActivityLog[]
}

model BodyLog {
  id                       String   @id @default(uuid())
  userId                   String
  googleHealthConnectionId String?
  measuredOn               DateTime @db.Date
  weightGramsAvg           Float?
  bodyFatPercentageAvg     Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleHealthConnection GoogleHealthConnection? @relation(fields: [googleHealthConnectionId], references: [id])

  @@unique([userId, measuredOn])
}

model ActivityLog {
  id                       String   @id @default(uuid())
  userId                   String
  googleHealthConnectionId String?
  measuredOn               DateTime @db.Date
  stepsCountSum            Int?
  totalCaloriesKcalSum     Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleHealthConnection GoogleHealthConnection? @relation(fields: [googleHealthConnectionId], references: [id], onDelete: SetNull)

  @@unique([userId, measuredOn])
}
